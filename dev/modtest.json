  "mp": {
    "cases": {
      "join": {
        "clients": [
          {
            "user": "Host",
            "role": "host",
            "seconds": 60
          },
          {
            "user": "Guest",
            "role": "guest",
            "seconds": 60,
            "after": "Host joined the game"
          }
        ],
        "steps": [
          {
            "wait": "Host joined the game",
            "timeout": 240
          },
          {
            "wait": "Guest joined the game",
            "timeout": 240
          }
        ]
      },
      "m1": {
        "jvm_props": {
          "vanilla_timber.perf": "true"
        },
        "clients": [
          {
            "user": "Host",
            "role": "host",
            "vars": {
              "mode": "mp-host"
            },
            "seconds": 420
          },
          {
            "user": "Guest",
            "role": "guest",
            "mod_jar": false,
            "jars": [
              "dev/probe/timberprobe.jar"
            ],
            "props": {
              "timberprobe.out": "{out}"
            },
            "seconds": 420,
            "after": "Host joined the game"
          }
        ],
        "steps": [
          {
            "wait": "Host joined the game",
            "timeout": 300,
            "send": [
              "op Host",
              "gamemode survival Host",
              "gamerule spawn_mobs false",
              "gamerule advance_time false",
              "gamerule advance_weather false",
              "time set 6000",
              "weather clear",
              "effect give Host haste infinite 127 true",
              "give Host minecraft:netherite_axe"
            ]
          },
          {
            "wait": "Guest joined the game",
            "timeout": 300,
            "send": [
              "gamemode survival Guest"
            ]
          },
          {
            "name": "four_falls",
            "wait": "(?s)(\\[perf\\] fall.*){4}",
            "timeout": 400
          }
        ],
        "checks": [
          {
            "name": "perf_lines",
            "count": "\\[perf\\] fall",
            "min": 4,
            "max": 4
          }
        ]
      },
