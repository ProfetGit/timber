execute if score #max_logs timber.config matches ..15 run scoreboard players set #max_logs timber.config 16
execute if score #max_logs timber.config matches 1025.. run scoreboard players set #max_logs timber.config 1024
execute if score #max_blocks timber.config matches ..99 run scoreboard players set #max_blocks timber.config 100
execute if score #max_blocks timber.config matches 1201.. run scoreboard players set #max_blocks timber.config 1200
execute if score #radius timber.config matches ..3 run scoreboard players set #radius timber.config 4
execute if score #radius timber.config matches 33.. run scoreboard players set #radius timber.config 32
execute unless score #sneak timber.config matches 0..2 run scoreboard players set #sneak timber.config 0
execute unless score #drops timber.config matches 0..1 run scoreboard players set #drops timber.config 0
